{
  "name": "Notification",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "title": "کاربر هدف"
    },
    "title": {
      "type": "string",
      "title": "عنوان"
    },
    "message": {
      "type": "string",
      "title": "پیام"
    },
    "type": {
      "type": "string",
      "enum": ["task_assigned", "meeting_request", "announcement", "expense_submitted", "leave_request", "comment", "work_report", "general"],
      "title": "نوع"
    },
    "entity_type": {
      "type": "string",
      "title": "نوع موجودیت"
    },
    "entity_id": {
      "type": "string",
      "title": "شناسه موجودیت"
    },
    "read": {
      "type": "boolean",
      "default": false,
      "title": "خوانده شده"
    },
    "link": {
      "type": "string",
      "title": "لینک"
    }
  },
  "required": ["user_id", "title", "message"],
  "rls": {
    "create": null,
    "read": {
      "$or": [
        { "data.user_id": "{{user.id}}" },
        { "user_condition": { "role": "admin" } }
      ]
    },
    "update": {
      "$or": [
        { "data.user_id": "{{user.id}}" },
        { "user_condition": { "role": "admin" } }
      ]
    },
    "delete": {
      "$or": [
        { "data.user_id": "{{user.id}}" },
        { "user_condition": { "role": "admin" } }
      ]
    }
  }
}