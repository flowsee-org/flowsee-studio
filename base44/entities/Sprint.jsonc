{
  "name": "Sprint",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "نام اسپرینت"
    },
    "description": {
      "type": "string",
      "title": "توضیحات"
    },
    "start_date": {
      "type": "string",
      "format": "date",
      "title": "تاریخ شروع"
    },
    "end_date": {
      "type": "string",
      "format": "date",
      "title": "تاریخ پایان"
    },
    "status": {
      "type": "string",
      "enum": ["planning", "active", "completed"],
      "default": "planning",
      "title": "وضعیت"
    },
    "goal": {
      "type": "string",
      "title": "هدف اسپرینت"
    }
  },
  "required": ["name", "start_date", "end_date"],
  "rls": {
    "create": { "user_condition": { "role": "admin" } },
    "read": null,
    "update": { "user_condition": { "role": "admin" } },
    "delete": { "user_condition": { "role": "admin" } }
  }
}