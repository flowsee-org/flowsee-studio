{
  "name": "Project",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "نام پروژه"
    },
    "description": {
      "type": "string",
      "title": "توضیحات"
    },
    "color": {
      "type": "string",
      "default": "#FE5400",
      "title": "رنگ"
    },
    "status": {
      "type": "string",
      "enum": ["active", "completed", "paused"],
      "default": "active",
      "title": "وضعیت"
    },
    "priority": {
      "type": "string",
      "enum": ["low", "medium", "high"],
      "default": "medium",
      "title": "اولویت"
    },
    "archived": {
      "type": "boolean",
      "default": false,
      "title": "بایگانی شده"
    },
    "manager": {
      "type": "string",
      "title": "مدیر پروژه"
    },
    "members": {
      "type": "array",
      "items": { "type": "string" },
      "title": "اعضای پروژه"
    },
    "start_date": {
      "type": "string",
      "format": "date",
      "title": "تاریخ شروع"
    },
    "end_date": {
      "type": "string",
      "format": "date",
      "title": "تاریخ پایان"
    },
    "budget": {
      "type": "number",
      "default": 0,
      "title": "بودجه (تومان)"
    },
    "milestones": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "date": { "type": "string" },
          "completed": { "type": "boolean", "default": false }
        }
      },
      "title": "نقاط عطف"
    },
    "status_updates": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "text": { "type": "string" },
          "author": { "type": "string" },
          "date": { "type": "string" }
        }
      },
      "title": "به‌روزرسانی‌ها"
    },
    "completion_checklist": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "text": { "type": "string" },
          "done": { "type": "boolean", "default": false }
        }
      },
      "title": "چک‌لیست تکمیل"
    }
  },
  "required": ["name"],
  "rls": {
    "create": {
      "user_condition": { "role": "admin" }
    },
    "read": null,
    "update": {
      "user_condition": { "role": "admin" }
    },
    "delete": {
      "user_condition": { "role": "admin" }
    }
  }
}
