{
  "name": "WorkReport",
  "type": "object",
  "properties": {
    "employee_name": {
      "type": "string",
      "title": "نام کارمند"
    },
    "task_id": {
      "type": "string",
      "title": "تسک"
    },
    "task_title": {
      "type": "string",
      "title": "عنوان تسک"
    },
    "task_ids": {
      "type": "array",
      "items": { "type": "string" },
      "title": "تسک‌های مرتبط"
    },
    "task_titles": {
      "type": "array",
      "items": { "type": "string" },
      "title": "عناوین تسک"
    },
    "project_name": {
      "type": "string",
      "title": "پروژه"
    },
    "hours": {
      "type": "number",
      "title": "ساعت کار"
    },
    "description": {
      "type": "string",
      "title": "توضیحات کار انجام شده"
    },
    "date": {
      "type": "string",
      "format": "date",
      "title": "تاریخ"
    },
    "ai_analysis": {
      "type": "string",
      "title": "تحلیل هوش مصنوعی"
    },
    "status": {
      "type": "string",
      "enum": ["draft", "submitted", "approved", "rejected"],
      "default": "submitted",
      "title": "وضعیت"
    },
    "reviewer_notes": {
      "type": "string",
      "title": "یادداشت بررسی‌کننده"
    }
  },
  "required": ["employee_name", "description", "date"],
  "rls": {
    "create": null,
    "read": {
      "$or": [
        { "created_by_id": "{{user.id}}" },
        { "user_condition": { "role": "admin" } }
      ]
    },
    "update": {
      "$or": [
        { "created_by_id": "{{user.id}}" },
        { "user_condition": { "role": "admin" } }
      ]
    },
    "delete": {
      "$or": [
        { "created_by_id": "{{user.id}}" },
        { "user_condition": { "role": "admin" } }
      ]
    }
  }
}