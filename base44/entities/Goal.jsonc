{
  "name": "Goal",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "title": "عنوان هدف"
    },
    "description": {
      "type": "string",
      "title": "توضیحات"
    },
    "owner": {
      "type": "string",
      "title": "مسئول"
    },
    "quarter": {
      "type": "string",
      "title": "quarter"
    },
    "year": {
      "type": "number",
      "title": "سال"
    },
    "key_results": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": { "type": "string" },
          "target": { "type": "number" },
          "current": { "type": "number", "default": 0 },
          "unit": { "type": "string" }
        }
      },
      "title": "نتایج کلیدی"
    },
    "status": {
      "type": "string",
      "enum": ["on_track", "at_risk", "behind", "completed"],
      "default": "on_track",
      "title": "وضعیت"
    }
  },
  "required": ["title"],
  "rls": {
    "create": { "user_condition": { "role": "admin" } },
    "read": null,
    "update": { "user_condition": { "role": "admin" } },
    "delete": { "user_condition": { "role": "admin" } }
  }
}