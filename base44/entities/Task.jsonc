{
  "name": "Task",
  "type": "object",
  "properties": {
    "task_number": {
      "type": "string",
      "title": "شماره تسک"
    },
    "title": {
      "type": "string",
      "title": "عنوان تسک"
    },
    "project_id": {
      "type": "string",
      "title": "پروژه"
    },
    "project_name": {
      "type": "string",
      "title": "نام پروژه"
    },
    "status": {
      "type": "string",
      "enum": ["todo", "in_progress", "done"],
      "default": "todo",
      "title": "وضعیت"
    },
    "assignee": {
      "type": "string",
      "title": "مسئول"
    },
    "assignees": {
      "type": "array",
      "items": { "type": "string" },
      "title": "مسئولین"
    },
    "priority": {
      "type": "string",
      "enum": ["low", "medium", "high"],
      "default": "medium",
      "title": "اولویت"
    },
    "description": {
      "type": "string",
      "title": "توضیحات"
    },
    "due_date": {
      "type": "string",
      "format": "date",
      "title": "تاریخ سررسید"
    },
    "subtasks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": { "type": "string" },
          "done": { "type": "boolean", "default": false }
        }
      },
      "title": "زیرتسک‌ها"
    },
    "time_spent": {
      "type": "number",
      "default": 0,
      "title": "ساعت کار (ساعت)"
    },
    "archived": {
      "type": "boolean",
      "default": false,
      "title": "بایگانی شده"
    },
    "recurring_config": {
      "type": "object",
      "properties": {
        "frequency": { "type": "string", "enum": ["daily", "weekly", "monthly"] },
        "day_of_week": { "type": "number" },
        "day_of_month": { "type": "number" }
      },
      "title": "تکرار دوره‌ای"
    },
    "attachments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "url": { "type": "string" },
          "type": { "type": "string" }
        }
      },
      "title": "پیوست‌ها"
    },
    "sprint_id": {
      "type": "string",
      "title": "اسپرینت"
    },
    "kind": {
      "type": "string",
      "title": "نوع"
    },
    "request_status": {
      "type": "string",
      "title": "وضعیت درخواست"
    },
    "requestee": {
      "type": "string",
      "title": "گیرنده درخواست"
    },
    "requestee_note": {
      "type": "string",
      "title": "پیام گیرنده"
    }
  },
  "required": ["title"],
  "rls": {
    "create": null,
    "read": null,
    "update": {
      "$or": [
        { "created_by_id": "{{user.id}}" },
        { "user_condition": { "role": "admin" } }
      ]
    },
    "delete": {
      "$or": [
        { "created_by_id": "{{user.id}}" },
        { "user_condition": { "role": "admin" } }
      ]
    }
  }
}