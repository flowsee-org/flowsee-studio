{
  "name": "ActivityLog",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "title": "شناسه کاربر"
    },
    "user_name": {
      "type": "string",
      "title": "نام کاربر"
    },
    "action": {
      "type": "string",
      "enum": ["create", "update", "delete", "status_change", "assign", "comment", "complete"],
      "title": "عملیات"
    },
    "entity_type": {
      "type": "string",
      "title": "نوع موجودیت"
    },
    "entity_id": {
      "type": "string",
      "title": "شناسه موجودیت"
    },
    "entity_title": {
      "type": "string",
      "title": "عنوان موجودیت"
    },
    "details": {
      "type": "string",
      "title": "جزئیات"
    }
  },
  "required": ["action", "entity_type"],
  "rls": {
    "create": null,
    "read": { "user_condition": { "role": "admin" } },
    "update": { "user_condition": { "role": "superadmin" } },
    "delete": { "user_condition": { "role": "superadmin" } }
  }
}