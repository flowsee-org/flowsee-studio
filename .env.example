# Main site / API base URL used by the Studio admin panels
# (SiteContent, BlogContent, WebsiteMessages and the editor image upload).
#
# Production (the main site API):
#   VITE_MAIN_API_URL=https://flowsee.ir
# Local Laravel backend:
#   VITE_MAIN_API_URL=http://localhost:8000
# Local self-hosted backend (the dev server serves /api on the same origin):
#   VITE_MAIN_API_URL=

VITE_MAIN_API_URL=https://flowsee.ir
