{
  "name": "Announcement",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "title": "عنوان"
    },
    "body": {
      "type": "string",
      "title": "متن"
    },
    "file_url": {
      "type": "string",
      "title": "فایل پیوست"
    },
    "target_audience": {
      "type": "string",
      "enum": ["all", "team", "individual"],
      "default": "all",
      "title": "مخاطب"
    },
    "target_team": {
      "type": "string",
      "title": "تیم هدف"
    },
    "target_names": {
      "type": "array",
      "items": { "type": "string" },
      "title": "افراد هدف"
    },
    "pinned": {
      "type": "boolean",
      "default": false,
      "title": "پین شده"
    },
    "read_by": {
      "type": "array",
      "items": { "type": "string" },
      "title": "خوانده شده توسط"
    },
    "expires_at": {
      "type": "string",
      "format": "date",
      "title": "تاریخ انقضا"
    }
  },
  "required": ["title", "body"],
  "rls": {
    "create": { "user_condition": { "role": "admin" } },
    "read": null,
    "update": { "user_condition": { "role": "admin" } },
    "delete": { "user_condition": { "role": "admin" } }
  }
}