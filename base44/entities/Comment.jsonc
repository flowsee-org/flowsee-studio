{
  "name": "Comment",
  "type": "object",
  "properties": {
    "entity_type": {
      "type": "string",
      "enum": ["task", "announcement", "project"],
      "title": "نوع موجودیت"
    },
    "entity_id": {
      "type": "string",
      "title": "شناسه موجودیت"
    },
    "author_name": {
      "type": "string",
      "title": "نویسنده"
    },
    "author_email": {
      "type": "string",
      "title": "ایمیل نویسنده"
    },
    "text": {
      "type": "string",
      "title": "متن"
    },
    "parent_id": {
      "type": "string",
      "title": "پاسخ به"
    }
  },
  "required": ["entity_type", "entity_id", "text"],
  "rls": {
    "create": null,
    "read": null,
    "update": {
      "$or": [
        { "created_by_id": "{{user.id}}" },
        { "user_condition": { "role": "admin" } }
      ]
    },
    "delete": {
      "$or": [
        { "created_by_id": "{{user.id}}" },
        { "user_condition": { "role": "admin" } }
      ]
    }
  }
}