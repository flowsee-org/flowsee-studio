{
  "name": "Employee",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "نام"
    },
    "role": {
      "type": "string",
      "title": "سمت"
    },
    "email": {
      "type": "string",
      "format": "email",
      "title": "ایمیل"
    },
    "phone": {
      "type": "string",
      "title": "تلفن"
    },
    "profile_image": {
      "type": "string",
      "title": "تصویر پروفایل"
    },
    "department": {
      "type": "string",
      "title": "دپارتمان"
    },
    "position": {
      "type": "string",
      "title": "سمت شغلی"
    },
    "hire_date": {
      "type": "string",
      "format": "date",
      "title": "تاریخ استخدام"
    },
    "skills": {
      "type": "array",
      "items": { "type": "string" },
      "title": "مهارت‌ها"
    },
    "bio": {
      "type": "string",
      "title": "درباره من"
    }
  },
  "required": ["name"],
  "rls": {
    "create": { "user_condition": { "role": "admin" } },
    "read": null,
    "update": { "user_condition": { "role": "admin" } },
    "delete": { "user_condition": { "role": "admin" } }
  }
}