{
  "name": "TaskTemplate",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "title": "\u0639\u0646\u0648\u0627\u0646 \u0642\u0627\u0644\u0628"
    },
    "description": {
      "type": "string",
      "title": "\u062a\u0648\u0636\u06cc\u062d\u0627\u062a"
    },
    "checklist": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "\u0686\u06a9\u200c\u0644\u06cc\u0633\u062a"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "default": "medium",
      "title": "\u0627\u0648\u0644\u0648\u06cc\u062a"
    },
    "project_id": {
      "type": "string",
      "title": "\u067e\u0631\u0648\u0698\u0647"
    },
    "project_name": {
      "type": "string",
      "title": "\u0646\u0627\u0645 \u067e\u0631\u0648\u0698\u0647"
    },
    "default_assignees": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "\u0645\u0633\u0626\u0648\u0644\u06cc\u0646 \u067e\u06cc\u0634\u200c\u0641\u0631\u0636"
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
